+type blockingBody struct {
+	entered chan struct{}
+	finish  chan struct{}
+}
+
+func (r *blockingBody) Read([]byte) (int, error) {
+	close(r.entered)
+	<-r.finish
+	return 0, io.EOF
+}
+
+func TestBodyGuardCancelledReaderKeepsCapacityUntilReadStops(t *testing.T) {
+	h := NewHandler(Config{Ingress: BodyLimits{1, 1, 1}})
+	reader := &blockingBody{entered: make(chan struct{}), finish: make(chan struct{})}
+	r, _ := bodyRequest(reader, -1)
+	ctx, cancel := context.WithCancel(r.Context())
+	r = r.WithContext(ctx)
+	done := make(chan error, 1)
+	go func() { _, _, err := h.readChatBody(httptest.NewRecorder(), r); done <- err }()
+	select {
+	case <-reader.entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("reader did not start")
+	}
+	cancel()
+	r2, source := bodyRequest(strings.NewReader("test"), 4)
+	_, _, err := h.readChatBody(httptest.NewRecorder(), r2)
+	if !errors.Is(err, errBodyCapacity) || source.reads != 0 {
+		t.Errorf("cancellation released a still-blocked reader: %v", err)
+	}
+	close(reader.finish)
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("cancelled reader result: %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("reader did not stop")
+	}
+	assertBodyBudgetEmpty(t, h)
+}

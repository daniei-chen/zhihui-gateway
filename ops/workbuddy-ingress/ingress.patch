+func TestBodyGuardCapacityResponseAndPrivateStatus(t *testing.T) {
+	p := testPoolWith()
+	h := NewHandler(Config{Pool: p, APIKey: "fixture", Ingress: BodyLimits{1, 1, 1}})
+	lease, err := h.acquireBody(16)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lease.release()
+	r, source := bodyRequest(strings.NewReader("test"), 4)
+	r.Header.Set("Authorization", "Bearer fixture")
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, r)
+	if rec.Code != 503 || rec.Header().Get("Retry-After") != "1" || source.reads != 0 {
+		t.Fatalf("saturation response: %d reads=%d", rec.Code, source.reads)
+	}
+	assertJSONErrorCode(t, rec.Body.String(), "body_capacity_exceeded")
+	status := h.bodyStatus()
+	if status["active_bodies"] != 1 || status["reserved_body_bytes"] != int64(16) || status["capacity_rejections_total"] != uint64(1) {
+		t.Fatalf("status not actual: %+v", status)
+	}
+	r = httptest.NewRequest("GET", "/status", nil)
+	rec = httptest.NewRecorder()
+	h.ServeHTTP(rec, r)
+	if rec.Code != 401 || strings.Contains(rec.Body.String(), "reserved_body_bytes") {
+		t.Fatal("private capacity state exposed without authentication")
+	}
+}

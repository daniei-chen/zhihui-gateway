+func TestBodyBudgetConcurrentReservationRace(t *testing.T) {
+	h := NewHandler(Config{Ingress: BodyLimits{1, 1, 4}})
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r, _ := bodyRequest(bytes.NewReader(make([]byte, 64<<10)), -1)
+			_, release, err := h.readChatBody(httptest.NewRecorder(), r)
+			if err == nil {
+				release()
+			} else if !errors.Is(err, errBodyCapacity) {
+				t.Errorf("unexpected error: %v", err)
+			}
+		}()
+	}
+	wg.Wait()
+	assertBodyBudgetEmpty(t, h)
+}

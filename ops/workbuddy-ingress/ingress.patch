+		want, code := 401, "invalid_api_key"
+		if valid {
+			want, code = 413, "request_too_large"
+		}
+		if rec.Code != want || source.reads != 0 {
+			t.Fatalf("valid=%v status=%d reads=%d", valid, rec.Code, source.reads)
+		}
+		assertJSONErrorCode(t, rec.Body.String(), code)
+		assertBodyBudgetEmpty(t, h)
+	}
+	st, _ := p.Status("fixture")
+	if calls != 0 || st.Cooling || st.Disabled || st.ErrTotal != 0 {
+		t.Fatalf("body rejection reached provider or penalized account: calls=%d state=%+v", calls, st)
+	}
+}

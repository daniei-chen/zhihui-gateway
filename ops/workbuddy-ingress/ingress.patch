+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestIngressDefaultsAndExplicitConfiguration(t *testing.T) {
+	for _, value := range []string{`{}`, `{"server":{"max_body_mb":1024}}`, `{"ingress":{"max_body_mb":2,"max_buffered_body_mb":8,"max_concurrent_bodies":3}}`} {
+		fp := filepath.Join(t.TempDir(), "config.json")
+		if err := os.WriteFile(fp, []byte(value), 0600); err != nil {
+			t.Fatal(err)
+		}
+		c, err := Load(fp)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(value, `"ingress"`) {
+			if c.Ingress.MaxBodyMB != 2 || c.Ingress.MaxBufferedBodyMB != 8 || c.Ingress.MaxConcurrentBodies != 3 {
+				t.Fatalf("explicit ingress ignored: %+v", c.Ingress)
+			}
+		} else if c.Ingress.MaxBodyMB != 64 || c.Ingress.MaxBufferedBodyMB != 128 || c.Ingress.MaxConcurrentBodies != 32 {
+			t.Fatalf("defaults or legacy ignored-field contract changed: %+v", c.Ingress)
+		}
+	}
+}
+
+func TestIngressInvalidConfigurationRejectsStartup(t *testing.T) {
+	for _, fields := range []string{`"max_body_mb":-1`, `"max_body_mb":513`, `"max_body_mb":"64"`, `"max_buffered_body_mb":32`, `"max_buffered_body_mb":1025`, `"max_concurrent_bodies":-1`, `"max_concurrent_bodies":257`} {
+		fp := filepath.Join(t.TempDir(), "config.json")
+		if err := os.WriteFile(fp, []byte(`{"ingress":{`+fields+`}}`), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := Load(fp); err == nil {
+			t.Fatalf("invalid ingress accepted: %s", fields)
+		}
+	}
+}

+func TestBodyGuardRealHTTPChunkedRejectAndSmallRequest(t *testing.T) {
+	var calls atomic.Int32
+	up := newFakeUpstream(t, func(string) (int, string, bool) { calls.Add(1); return 200, sseOK, true })
+	p := testPoolWith(&auth.Auth{UID: "fixture", AccessToken: "fixture", ExpiresAt: 9999999999})
+	h := NewHandler(Config{Pool: p, Upstream: up, Ingress: BodyLimits{1, 2, 2}})
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+	for _, big := range []bool{true, false} {
+		value := `{"model":"glm-5.2","messages":[]}`
+		if big {
+			value = strings.Repeat("x", 2<<20)
+		}
+		req, err := http.NewRequest("POST", srv.URL+"/v1/chat/completions", struct{ io.Reader }{strings.NewReader(value)})
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp, err := srv.Client().Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _ = io.Copy(io.Discard, resp.Body)
+		resp.Body.Close()
+		want := 200
+		if big {
+			want = 413
+		}
+		if resp.StatusCode != want {
+			t.Fatalf("chunked=%v status=%d", big, resp.StatusCode)
+		}
+	}
+	if calls.Load() != 1 {
+		t.Fatalf("upstream calls=%d", calls.Load())
+	}
+	assertBodyBudgetEmpty(t, h)
+}

+func TestBodyBudgetConcurrentReleaseIsIdempotent(t *testing.T) {
+	h := NewHandler(Config{Ingress: BodyLimits{1, 1, 1}})
+	r, _ := bodyRequest(strings.NewReader("test"), 4)
+	_, release, err := h.readChatBody(httptest.NewRecorder(), r)

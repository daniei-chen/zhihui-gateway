+)
+
+func assertBodyBudgetEmpty(t *testing.T, h *Handler) {
+	t.Helper()
+	h.bodyBudget.mu.Lock()
+	defer h.bodyBudget.mu.Unlock()
+	if h.bodyBudget.active != 0 || h.bodyBudget.retained != 0 {
+		t.Fatalf("body lease leaked: active=%d retained=%d", h.bodyBudget.active, h.bodyBudget.retained)
+	}
+}
+
+type countedBody struct {
+	r     io.Reader
+	reads int
+	close bool
+}
+
+func (r *countedBody) Read(b []byte) (int, error) { r.reads++; return r.r.Read(b) }
+func (r *countedBody) Close() error               { r.close = true; return nil }
+
+func bodyRequest(reader io.Reader, declared int64) (*http.Request, *countedBody) {
+	r := httptest.NewRequest("POST", "/v1/chat/completions", nil)
+	body := &countedBody{r: reader}
+	r.Body, r.ContentLength = body, declared
+	return r, body
+}
+
+func TestIngressLimitsNormalize(t *testing.T) {
+	v := BodyLimits{}
+	if err := v.Normalize(); err != nil || v != (BodyLimits{64, 128, 32}) {
+		t.Fatalf("defaults=%+v err=%v", v, err)
+	}
+	for _, v := range []BodyLimits{{-1, 128, 32}, {513, 1024, 32}, {64, -1, 32}, {64, 63, 32}, {64, 1025, 32}, {64, 128, -1}, {64, 128, 257}} {
+		if err := v.Normalize(); err == nil {
+			t.Errorf("accepted invalid bounds: %+v", v)
+		}
+	}
+}
+
+func TestBodyGuardExactBoundaryAndUnknownLength(t *testing.T) {
+	for _, declared := range []int64{-1, 1 << 20} {
+		h := NewHandler(Config{Ingress: BodyLimits{1, 1, 1}})
+		r, source := bodyRequest(strings.NewReader(strings.Repeat("x", 1<<20)), declared)
+		body, release, err := h.readChatBody(httptest.NewRecorder(), r)
+		if err != nil || len(body) != 1<<20 || !source.close {
+			t.Fatalf("boundary failed: bytes=%d closed=%v err=%v", len(body), source.close, err)
+		}
+		if h.bodyBudget.active != 1 || h.bodyBudget.retained != 1<<20 {
+			t.Fatal("successful read must retain its lease while forwarding")
+		}
+		release()
+		release()
+		assertBodyBudgetEmpty(t, h)
+	}
+}
+
+func TestBodyGuardRejectsDeclaredOversizeBeforeRead(t *testing.T) {
+	h := NewHandler(Config{Ingress: BodyLimits{1, 1, 1}})
+	r, source := bodyRequest(strings.NewReader("never read"), 1<<20+1)
+	_, _, err := h.readChatBody(httptest.NewRecorder(), r)
+	var large *http.MaxBytesError
+	if !errors.As(err, &large) || source.reads != 0 {
+		t.Fatalf("err=%v reads=%d", err, source.reads)
+	}
+	assertBodyBudgetEmpty(t, h)
+}
+
+func TestBodyGuardCountsActualChunkedAndUnderstatedBytes(t *testing.T) {
+	for _, declared := range []int64{-1, 1, 1 << 20} {
+		h := NewHandler(Config{Ingress: BodyLimits{1, 1, 1}})
+		r, source := bodyRequest(strings.NewReader(strings.Repeat("x", 2<<20)), declared)
+		_, _, err := h.readChatBody(httptest.NewRecorder(), r)
+		var large *http.MaxBytesError
+		if !errors.As(err, &large) || !source.close || source.reads > 33 {
+			t.Fatalf("err=%v closed=%v reads=%d", err, source.close, source.reads)
+		}
+		assertBodyBudgetEmpty(t, h)
+	}
+}
+
+func TestBodyGuardReadErrorAndLengthMismatchReleaseCapacity(t *testing.T) {
+	for _, value := range []struct {
+		r        io.Reader
+		declared int64
+	}{{errReader{errors.New("private-client-token")}, -1}, {strings.NewReader("short"), 10}, {strings.NewReader("long"), 1}, {strings.NewReader("undeclared"), 0}} {
+		h := NewHandler(Config{Ingress: BodyLimits{1, 1, 1}})
+		r, source := bodyRequest(value.r, value.declared)

+func TestBodyGuardRetainsLeaseThroughoutProviderForwarding(t *testing.T) {
+	entered, finish := make(chan struct{}), make(chan struct{})
+	up := newFakeUpstream(t, func(string) (int, string, bool) {
+		close(entered)
+		select {
+		case <-finish:
+		case <-time.After(3 * time.Second):
+			t.Error("fixture did not release provider")
+		}
+		return 200, sseOK, true
+	})
+	p := testPoolWith(&auth.Auth{UID: "fixture", AccessToken: "fixture", ExpiresAt: 9999999999})
+	h := NewHandler(Config{Pool: p, Upstream: up, Ingress: BodyLimits{1, 1, 1}})
+	done := make(chan int, 1)
+	go func() {
+		r := httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(`{"model":"glm-5.2","stream":true,"messages":[]}`))
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		done <- w.Code
+	}()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("provider did not start")
+	}
+	r, source := bodyRequest(strings.NewReader("never read"), 10)
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if w.Code != 503 || source.reads != 0 || h.bodyStatus()["active_bodies"] != 1 {
+		t.Errorf("body lease released before forwarding finished: code=%d reads=%d", w.Code, source.reads)
+	}
+	close(finish)
+	select {
+	case code := <-done:
+		if code != 200 {
+			t.Fatalf("original stream status: %d", code)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("provider did not stop")
+	}
+	assertBodyBudgetEmpty(t, h)
+}

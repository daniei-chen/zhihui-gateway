+package server
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"sync"
+)
+
+// BodyLimits bounds retained raw request bytes, not the complete process heap.
+// JSON decoding and outbound copies still require additional container headroom.
+type BodyLimits struct {
+	MaxBodyMB           int64 `json:"max_body_mb"`
+	MaxBufferedBodyMB   int64 `json:"max_buffered_body_mb"`
+	MaxConcurrentBodies int   `json:"max_concurrent_bodies"`
+}
+
+func (v *BodyLimits) Normalize() error {
+	if v.MaxBodyMB == 0 {
+		v.MaxBodyMB = 64
+	}
+	if v.MaxBufferedBodyMB == 0 {
+		v.MaxBufferedBodyMB = 128
+	}
+	if v.MaxConcurrentBodies == 0 {
+		v.MaxConcurrentBodies = 32
+	}
+	if v.MaxBodyMB < 1 || v.MaxBodyMB > 512 {
+		return fmt.Errorf("ingress.max_body_mb must be between 1 and 512")
+	}
+	if v.MaxBufferedBodyMB < v.MaxBodyMB || v.MaxBufferedBodyMB > 1024 {
+		return fmt.Errorf("ingress.max_buffered_body_mb must be between max_body_mb and 1024")
+	}
+	if v.MaxConcurrentBodies < 1 || v.MaxConcurrentBodies > 256 {
+		return fmt.Errorf("ingress.max_concurrent_bodies must be between 1 and 256")
+	}
+	return nil
+}
+
+var errBodyCapacity = errors.New("request body capacity exhausted")
+
+type bodyBudget struct {
+	mu       sync.Mutex
+	active   int
+	retained int64
+	rejected uint64
+}
+
+type bodyLease struct {
+	budget   *bodyBudget
+	reserved int64
+	released bool
+}
+
+func (h *Handler) acquireBody(declared int64) (*bodyLease, error) {
+	b := &h.bodyBudget
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	initial := max(declared, 0)
+	if b.active >= h.cfg.Ingress.MaxConcurrentBodies || initial > (h.cfg.Ingress.MaxBufferedBodyMB<<20)-b.retained {
+		b.rejected++
+		return nil, errBodyCapacity
+	}
+	b.active++
+	b.retained += initial
+	return &bodyLease{budget: b, reserved: initial}, nil
+}
+
+func (l *bodyLease) grow(size, maximum int64) error {
+	b := l.budget
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	additional := max(size-l.reserved, 0)
+	if additional > maximum-b.retained {
+		b.rejected++
+		return errBodyCapacity
+	}
+	b.retained += additional
+	l.reserved += additional
+	return nil
+}
+
+func (l *bodyLease) release() {
+	b := l.budget
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if l.released {
+		return
+	}
+	b.active--
+	b.retained -= l.reserved
+	l.released = true
+}
+
+func (h *Handler) bodyStatus() map[string]any {
+	b := &h.bodyBudget
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return map[string]any{
+		"max_body_bytes":            h.cfg.Ingress.MaxBodyMB << 20,
+		"max_buffered_body_bytes":   h.cfg.Ingress.MaxBufferedBodyMB << 20,
+		"max_concurrent_bodies":     h.cfg.Ingress.MaxConcurrentBodies,
+		"active_bodies":             b.active,
+		"reserved_body_bytes":       b.retained,
+		"capacity_rejections_total": b.rejected,
+	}
+}
+
+// The lease lives until forwarding finishes, not just until the body is read:
+// long SSE requests retain their raw body for account rotation and statistics.
+func (h *Handler) readChatBody(w http.ResponseWriter, r *http.Request) ([]byte, func(), error) {
+	limit := h.cfg.Ingress.MaxBodyMB << 20
+	if r.ContentLength > limit {
+		return nil, nil, &http.MaxBytesError{Limit: limit}
+	}
+	lease, err := h.acquireBody(r.ContentLength)
+	if err != nil {
+		return nil, nil, err
+	}
+	success := false
+	defer func() {
+		if !success {
+			lease.release()
+		}
+	}()
+	reader := http.MaxBytesReader(w, r.Body, limit)
+	defer reader.Close()
+	var body []byte
+	var scratch [32 << 10]byte
+	emptyReads := 0
+	for {
+		if err := r.Context().Err(); err != nil {
+			return nil, nil, err
+		}
+		n, err := reader.Read(scratch[:])
+		if err != nil && err != io.EOF {
+			return nil, nil, err
+		}
+		if n > 0 {
+			emptyReads = 0
+			if err := lease.grow(int64(len(body)+n), h.cfg.Ingress.MaxBufferedBodyMB<<20); err != nil {
+				return nil, nil, err
+			}
+			body = append(body, scratch[:n]...)
+		}
+		if err == io.EOF {
+			break
+		}
+		if n == 0 {
+			emptyReads++
+			if emptyReads >= 100 {
+				return nil, nil, io.ErrNoProgress
+			}
+		}
+	}
+	if r.ContentLength >= 0 && int64(len(body)) != r.ContentLength {
+		return nil, nil, io.ErrUnexpectedEOF
+	}
+	if err := r.Context().Err(); err != nil {
+		return nil, nil, err
+	}
+	success = true
+	return body, lease.release, nil
+}
+
+func writeBodyError(w http.ResponseWriter, err error) {
+	var tooLarge *http.MaxBytesError
+	var timeout net.Error
+	switch {
+	case errors.As(err, &tooLarge):
+		writeOpenAIError(w, http.StatusRequestEntityTooLarge, "request_too_large", "request body exceeds ingress.max_body_mb")
+	case errors.Is(err, errBodyCapacity):
+		w.Header().Set("Retry-After", "1")
+		writeOpenAIError(w, http.StatusServiceUnavailable, "body_capacity_exceeded", "request body capacity exhausted; retry later")
+	case errors.Is(err, context.Canceled), errors.Is(err, context.DeadlineExceeded):
+		writeOpenAIError(w, http.StatusRequestTimeout, "body_read_timeout", "request body read interrupted")
+	case errors.As(err, &timeout) && timeout.Timeout():
+		writeOpenAIError(w, http.StatusRequestTimeout, "body_read_timeout", "request body read timed out")
+	default:
+		// Reader errors may contain client-controlled bytes or credentials.
+		writeOpenAIError(w, http.StatusBadRequest, "invalid_request", "request body could not be read completely")
+	}
+}

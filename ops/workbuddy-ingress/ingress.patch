+			t.Fatalf("unsafe read error: %d %s", rec.Code, rec.Body)
+		}
+		assertBodyBudgetEmpty(t, h)
+	}
+}
+
+func TestBodyGuardCancellationReleasesAndDoesNotRead(t *testing.T) {
+	h := NewHandler(Config{Ingress: BodyLimits{1, 1, 1}})
+	r, source := bodyRequest(strings.NewReader("body"), 4)

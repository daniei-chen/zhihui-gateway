+func TestV006ContextChoicesAreNativeAndSeparate(t *testing.T) {
+	var m dynModelEntry
+	if err := json.Unmarshal([]byte(`{"id":"test","maxInputTokens":1000000,"contextWindow":{"defaultLength":300000,"supportedLengths":[1000000,300000,300000]}}`), &m); err != nil {
+		t.Fatal(err)
+	}
+	mi := m.modelInfo()
+	if mi.ContextWindow != 1000000 || mi.DefaultContextWindow != 300000 || !reflect.DeepEqual(mi.ContextWindowOptions, []int64{300000, 1000000}) || mi.ContextWindowConflict {
+		t.Fatalf("context %#v", mi)
+	}
+	m.ContextWindow.DefaultLength = 2000000
+	mi = m.modelInfo()
+	if mi.DefaultContextWindow != 0 || !mi.ContextWindowConflict {
+		t.Fatal("conflicting default must not be clamped into an invented default")
+	}

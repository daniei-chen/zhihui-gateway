@@ -0,0 +1,42 @@
+package upstream
+
+import "sort"
+
+type modelContextWindow struct {
+	DefaultLength    int64   `json:"defaultLength"`
+	SupportedLengths []int64 `json:"supportedLengths"`
+}
+
+// A native default is a separate declaration, never inferred from the ceiling.
+func contextChoices(ceiling int64, window *modelContextWindow) (int64, []int64, bool) {
+	if window == nil {
+		return 0, nil, false
+	}
+	set := map[int64]bool{}
+	conflict := false
+	for i, value := range window.SupportedLengths {
+		if i >= 64 {
+			break
+		}
+		if value <= 0 {
+			continue
+		}
+		if ceiling > 0 && value > ceiling {
+			conflict = true
+			continue
+		}
+		set[value] = true
+	}
+	var options []int64
+	for value := range set {
+		options = append(options, value)
+	}
+	sort.Slice(options, func(i, j int) bool { return options[i] < options[j] })
+	def := window.DefaultLength
+	if def <= 0 {
+		def = 0
+	} else if ceiling > 0 && def > ceiling || len(options) > 0 && !set[def] {
+		def, conflict = 0, true
+	}
+	return def, options, conflict
+}

+func TestV006NativeProfileScopeAndOverrides(t *testing.T) {
+	for _, tc := range []struct{ url, profile, ua, version, cli, want, runtime string }{
+		{"https://copilot.tencent.com/v3/config", "desktop-5.9.3", "", "", "", "CLI/2.165.0", "local-agent"},
+		{"https://www.workbuddy.ai/v3/config", "desktop-5.9.3", "", "", "", "WorkBuddy/5.9.3", "local-agent"},
+		{"https://copilot.tencent.com/chat", "desktop-5.9.3", "", "9.1", "42", "CLI/42", "local-agent"},
+		{"https://copilot.tencent.com/chat", "desktop-5.9.3", "custom-agent", "", "", "custom-agent", "local-agent"},
+		{"https://relay.example/chat", "desktop-5.9.3", "", "", "", "CLI/" + defaultCliVersion, ""},
+		{"https://copilot.tencent.com:8443/chat", "desktop-5.9.3", "", "", "", "CLI/" + defaultCliVersion, ""},
+		{"https://copilot.tencent.com/chat", "legacy-v1", "", "", "", "CLI/" + defaultCliVersion, ""},
+	} {
+		req, _ := http.NewRequest("GET", tc.url, nil)
+		c := &Client{ProtocolProfile: tc.profile, UserAgent: tc.ua, ClientVersion: tc.version, CliVersion: tc.cli}
+		c.CommonHeaders(req, &auth.Auth{UID: "profile-fixture"})
+		c.ChatHeaders(req, &auth.Auth{UID: "profile-fixture"}, "", ChatMeta{})
+		if tc.runtime != "" {
+			want := tc.version
+			if want == "" {
+				want = "5.9.3"
+			}
+			if req.Header.Get("X-IDE-Version") != want {
+				t.Fatal("profile contains inconsistent IDE and UA versions")
+			}
+		}
+		if !strings.Contains(req.UserAgent(), tc.want) || req.Header.Get("X-Agent-Runtime") != tc.runtime {
+			t.Errorf("profile contract for %s: %v", tc.url, req.Header)
+		}
+	}

+++ b/internal/upstream/protocol_profile.go
@@ -0,0 +1,46 @@
+package upstream
+
+import (
+	"net/http"
+
+	"workbuddy2api/internal/auth"
+)
+
+func nativeClientUA(a *auth.Auth, client, cli string) string {
+	platform := "WorkBuddy"
+	if a != nil && a.IsGlobal() {
+		platform = "WorkBuddy AI"
+	}
+	return "WorkBuddy/" + client + " " + platform + "/" + client + " CLI/" + cli
+}
+
+// Protocol profiles change a coherent native-client header set. Custom relays
+// retain legacy headers. Explicit client/CLI/UA overrides retain precedence.
+// Desktop evidence: magpie-community/plugins 7ea*, WorkBuddy package snapshot.
+func (c *Client) injectProtocolProfile(req *http.Request, a *auth.Auth) {
+	if c.ProtocolProfile != "desktop-5.9.3" || req.URL == nil || req.URL.Scheme != "https" {
+		return
+	}
+	if port := req.URL.Port(); port != "" && port != "443" {
+		return
+	}
+	switch req.URL.Hostname() {
+	case "copilot.tencent.com", "www.workbuddy.ai":
+	default:
+		return
+	}
+	client, cli := c.ClientVersion, c.CliVersion
+	if client == "" {
+		client = "5.9.3"
+	}
+	if cli == "" {
+		cli = "2.165.0"
+	}
+	if c.UserAgent == "" {
+		req.Header.Set("User-Agent", nativeClientUA(a, client, cli))
+	}
+	if req.Header.Get("X-IDE-Version") != "" {
+		req.Header.Set("X-IDE-Version", client)
+	}
+	req.Header.Set("X-Agent-Runtime", "local-agent")
+}

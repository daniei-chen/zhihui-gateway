+package server
+
+// Zero is an unknown capability and must not be advertised as a guessed 1M.
+func applyContextCapacity(entry map[string]any, value, native int64) {
+	if value <= 0 {
+		entry["context_length_state"] = "unknown"
+		return
+	}
+	entry["context_length"] = value
+	if native > 0 {
+		entry["context_length_source"] = "provider"
+	} else {
+		entry["context_length_source"] = "catalog"
+	}
+}

+package upstream
+
+import (
+	"bytes"
+	"compress/gzip"
+	"io"
+	"math/rand"
+	"testing"
+)
+
+func TestZhihuiGzipThresholdAndSavings(t *testing.T) {
+	c := &Client{GzipBody: true}
+	if gzipBodyThreshold != 256<<10 {
+		t.Fatal("expected reviewed 256 KiB threshold")
+	}
+	for _, n := range []int{gzipBodyThreshold - 1, gzipBodyThreshold, gzipBodyThreshold + 1} {
+		raw := bytes.Repeat([]byte("x"), n)
+		out, encoding := c.outboundBody(raw)
+		if n < gzipBodyThreshold {
+			if encoding != "" || !bytes.Equal(out, raw) {
+				t.Fatal("small payload changed")
+			}
+			continue
+		}
+		if encoding != "gzip" || int64(len(out))*10 > int64(len(raw))*9 {
+			t.Fatal("large text must save ten percent")
+		}
+		reader, err := gzip.NewReader(bytes.NewReader(out))
+		if err != nil {
+			t.Fatal(err)
+		}
+		back, err := io.ReadAll(reader)
+		_ = reader.Close()
+		if err != nil || !bytes.Equal(back, raw) {
+			t.Fatal("compression changed content")
+		}
+	}
+	raw := make([]byte, 512<<10)
+	_, _ = rand.New(rand.NewSource(19)).Read(raw)
+	out, encoding := c.outboundBody(raw)
+	if encoding != "" || !bytes.Equal(out, raw) {
+		t.Fatal("incompressible input must stay unchanged")
+	}
+}

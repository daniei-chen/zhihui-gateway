+//go:build !windows
+
+package auth
+
+import (
+	"errors"
+	"os"
+	"syscall"
+)
+
+func openCredentialLock(path, source string) (*os.File, error) {
+	descriptor, err := syscall.Open(path, syscall.O_CREAT|syscall.O_RDWR|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	handle := os.NewFile(uintptr(descriptor), path)
+	initial, err := handle.Stat()
+	if err != nil || !initial.Mode().IsRegular() {
+		handle.Close()
+		return nil, errors.New("unsafe credential lock")
+	}
+	if owner, ok := initial.Sys().(*syscall.Stat_t); !ok || owner.Nlink != 1 {
+		handle.Close()
+		return nil, errors.New("unsafe credential lock links")
+	}
+	if sourceInfo, failure := os.Stat(source); failure == nil && os.Geteuid() == 0 {
+		if owner, ok := sourceInfo.Sys().(*syscall.Stat_t); ok {
+			if failure = handle.Chown(int(owner.Uid), int(owner.Gid)); failure != nil {
+				handle.Close()
+				return nil, failure
+			}
+		}
+	}
+	info, err := handle.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0o077 != 0 {
+		handle.Close()
+		if err == nil {
+			err = errors.New("unsafe credential lock")
+		}
+		return nil, err
+	}
+	return handle, nil
+}
+
+func prepareCredentialTemp(handle *os.File, source string, existed bool) error {
+	if !existed || os.Geteuid() != 0 {
+		return nil
+	}
+	info, err := os.Stat(source)
+	if err != nil {
+		return err
+	}
+	owner, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return errors.New("credential owner unavailable")
+	}
+	return handle.Chown(int(owner.Uid), int(owner.Gid))
+}
+
+func tryCredentialLock(handle *os.File) (bool, error) {
+	err := syscall.Flock(int(handle.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+	if errors.Is(err, syscall.EWOULDBLOCK) || errors.Is(err, syscall.EAGAIN) {
+		return false, nil
+	}
+	return err == nil, err
+}
+
+func unlockCredentialLock(handle *os.File) { syscall.Flock(int(handle.Fd()), syscall.LOCK_UN) }
+
+func syncCredentialDirectory(path string) error {
+	handle, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer handle.Close()
+	return handle.Sync()
+}

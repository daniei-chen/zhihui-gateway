+package upstream
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"testing"
+)
+
+type fragmentReader struct {
+	data []byte
+	size int
+}
+
+func TestChannelCheckRequiresUnambiguousChannelLanguage(test *testing.T) {
+	for _, sample := range []struct {
+		body string
+		want bool
+	}{
+		{`{"code":11128,"msg":"Illegal API invocation from an unapproved channel"}`, true},
+		{`{"code":11128,"msg":"blocked by security policy"}`, false},
+		{`{"code":11128}`, false},
+		{`{"code":11102,"msg":"unapproved channel"}`, false},
+	} {
+		if IsChannelCheck(sample.body) != sample.want {
+			test.Fatalf("unexpected classification for synthetic fixture %s", sample.body)
+		}
+	}
+}
+
+func (reader *fragmentReader) Read(buffer []byte) (int, error) {
+	if len(reader.data) == 0 {
+		return 0, io.EOF
+	}
+	count := min(len(buffer), reader.size, len(reader.data))
+	copy(buffer, reader.data[:count])
+	reader.data = reader.data[count:]
+	return count, nil
+}
+
+func FuzzAggregateFragmentation(fuzzer *testing.F) {
+	fuzzer.Add([]byte("data: [DONE]\n\n"), uint8(1))
+	fuzzer.Add([]byte("data: {\"id\":\"fixture\",\"created\":1,\"choices\":[{\"delta\":{\"content\":\"中文🙂\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"), uint8(3))
+	fuzzer.Add([]byte("data: {\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call\",\"function\":{\"name\":\"read\",\"arguments\":\"{\\\"port\\\":11128}\"}}]},\"finish_reason\":\"tool_calls\"}]}\n\ndata: [DONE]\n\n"), uint8(7))
+	fuzzer.Fuzz(func(test *testing.T, data []byte, step uint8) {
+		if len(data) > 65536 {
+			test.Skip()
+		}
+		full, fullErr := Aggregate(bytes.NewReader(data))
+		parts, partsErr := Aggregate(&fragmentReader{data: data, size: int(step%31) + 1})
+		if fmt.Sprint(fullErr) != fmt.Sprint(partsErr) {
+			test.Fatalf("fragmentation changed terminal error: %v / %v", fullErr, partsErr)
+		}
+		delete(full, "created")
+		delete(parts, "created")
+		delete(full, "id")
+		delete(parts, "id")
+		before, _ := json.Marshal(full)
+		after, _ := json.Marshal(parts)
+		if !bytes.Equal(before, after) {
+			test.Fatal("fragmentation changed aggregate output")
+		}
+	})
+}

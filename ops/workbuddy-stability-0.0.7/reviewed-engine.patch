+func TestLargeRequestSlidingBudgetBoundariesAndSoftFallback(t *testing.T) {
+	accounts := New("")
+	accounts.Add(&auth.Auth{UID: "busy", AccessToken: "synthetic"})
+	accounts.Add(&auth.Auth{UID: "spare", AccessToken: "synthetic"})
+	accounts.SetRoutingPreferences(0, 2, 100, time.Minute)
+	accounts.NoteLargeRequest("busy", 99)
+	accounts.NoteLargeRequest("busy", 100)
+	if accounts.RoutingExclusions(nil, "", "", 100)["busy"] {
+		t.Fatal("budget counted a small request")
+	}
+	accounts.NoteLargeRequest("busy", 100)
+	if !accounts.RoutingExclusions(nil, "", "", 100)["busy"] {
+		t.Fatal("large budget not applied")

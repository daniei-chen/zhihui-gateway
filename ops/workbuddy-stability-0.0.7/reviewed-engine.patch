+	}
+	if body["max_tokens"] != float64(64) {
+		t.Fatal("token alias lost")
+	}
+	if _, exists := body["thinking"]; exists {
+		t.Fatal("short request acquired implicit thinking")
+	}
+	if _, exists := body["reasoning_effort"]; exists {
+		t.Fatal("short request acquired implicit high effort")
+	}
+}

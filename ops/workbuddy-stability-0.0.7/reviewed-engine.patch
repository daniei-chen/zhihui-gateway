+				t.Fatal(err)
+			}
+			injectThinking(body, "high")
+			thinking, _ := body["thinking"].(map[string]any)
+			actual, _ := thinking["type"].(string)
+			if actual != entry.want {
+				t.Fatalf("thinking=%q want=%q", actual, entry.want)
+			}
+			if entry.want == "disabled" || entry.want == "" {
+				if _, present := body["reasoning_effort"]; present {
+					t.Fatal("disabled thinking acquired implicit effort")
+				}
+			}
+		})
+	}
+}

+func TestProviderBudgetBoundsAndSharedAuthorizations(t *testing.T) {
+	request := httptest.NewRequest("POST", "/v1/chat/completions", nil)
+	request.Header.Set("X-WB-Attempt-Budget", "2")
+	request.Header.Set("X-WB-Remaining-Ms", "1000")
+	writer := httptest.NewRecorder()
+	bounded, budget, cancel, err := requestProviderBudget(request, writer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cancel()
+	if deadline, ok := bounded.Context().Deadline(); !ok || time.Until(deadline) > time.Second {
+		t.Fatal("remaining deadline not propagated")
+	}
+	for count := 0; count < 2; count++ {
+		if err := budget.authorize(writer); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if !errors.Is(budget.authorize(writer), errProviderBudgetExhausted) || writer.Header().Get("X-WB-Provider-Attempts") != "2" {
+		t.Fatal("authorization count must be shared and bounded")
+	}
+}
+
+func TestInvalidProviderBudgetFailsBeforeDispatch(t *testing.T) {
+	for _, raw := range []string{"0", "9", "-1", "99999999999999999999999", "invalid"} {
+		request := httptest.NewRequest("POST", "/v1/chat/completions", nil)
+		request.Header.Set("X-WB-Attempt-Budget", raw)
+		if _, _, cancel, err := requestProviderBudget(request, httptest.NewRecorder()); err == nil {
+			cancel()
+			t.Fatalf("invalid budget accepted: %q", raw)
+		}
+	}
+}

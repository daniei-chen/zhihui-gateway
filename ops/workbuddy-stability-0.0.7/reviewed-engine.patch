+package server
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strconv"
+	"time"
+
+	"workbuddy2api/internal/upstream"
+)
+
+var errProviderBudgetExhausted = upstream.ErrProviderAttemptBudgetExhausted
+
+type providerBudget struct {
+	limit int
+	spent int
+}
+
+func requestProviderBudget(request *http.Request, writer http.ResponseWriter) (*http.Request, *providerBudget, context.CancelFunc, error) {
+	limit := 8
+	if raw := request.Header.Get("X-WB-Attempt-Budget"); raw != "" {
+		value, err := strconv.Atoi(raw)
+		if err != nil || value < 1 || value > 8 {
+			return request, nil, nil, errors.New("invalid provider attempt budget")
+		}
+		limit = value
+	}
+	ctx, cancel := context.WithCancel(request.Context())
+	if raw := request.Header.Get("X-WB-Remaining-Ms"); raw != "" {
+		value, err := strconv.Atoi(raw)
+		if err != nil || value < 1 || value > 600000 {
+			cancel()
+			return request, nil, nil, errors.New("invalid remaining deadline")
+		}
+		cancel()
+		ctx, cancel = context.WithTimeout(request.Context(), time.Duration(value)*time.Millisecond)
+	}
+	writer.Header().Set("X-WB-Provider-Attempts", "0")
+	return request.WithContext(ctx), &providerBudget{limit: limit}, cancel, nil
+}
+
+func (budget *providerBudget) authorize(writer http.ResponseWriter) error {
+	if budget.spent >= budget.limit {
+		return errProviderBudgetExhausted
+	}
+	budget.spent++
+	writer.Header().Set("X-WB-Provider-Attempts", strconv.Itoa(budget.spent))
+	return nil
+}

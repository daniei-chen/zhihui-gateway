+func TestRefreshCancelledWaiterDoesNotCancelLeader(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	client := testClient(rtFunc(func(request *http.Request) (*http.Response, error) {
+		close(entered)
+		<-release
+		if request.Context().Err() != nil {
+			t.Error("shared refresh cancelled with waiter")
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(
+			`{"code":0,"data":{"accessToken":"synthetic-new","refreshToken":"synthetic-new","expiresIn":3600}}`)), Header: http.Header{}}, nil
+	}))
+	account := &auth.Auth{UID: "synthetic-account", AccessToken: "synthetic-old", RefreshToken: "synthetic-old"}
+	leader := make(chan error, 1)
+	go func() { leader <- client.RefreshToken(account) }()
+	<-entered
+	waitContext, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := client.RefreshTokenContext(waitContext, account); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled waiter=%v", err)
+	}
+	close(release)
+	if err := <-leader; err != nil {
+		t.Fatal(err)
+	}
+}

+package upstream
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"sync/atomic"
+	"time"
+
+	"workbuddy2api/internal/auth"
+)
+
+type refreshCall struct {
+	done chan struct{}
+	err  error
+}
+
+type refreshFailure struct {
+	cause   error
+	claimed atomic.Bool
+}
+
+func (failure *refreshFailure) Error() string { return failure.cause.Error() }
+func (failure *refreshFailure) Unwrap() error { return failure.cause }
+
+func ClaimRefreshPenalty(failure error) bool {
+	if failure == nil || errors.Is(failure, context.Canceled) || errors.Is(failure, context.DeadlineExceeded) {
+		return false
+	}
+	var local *os.PathError
+	if errors.As(failure, &local) {
+		return false
+	}
+	var provider *Error
+	if errors.As(failure, &provider) && (provider.Kind == ErrContentBlocked || provider.Kind == ErrBadParams || provider.Kind == ErrToolCallMismatch || provider.Kind == ErrImageInvalid) {
+		return false
+	}
+	var shared *refreshFailure
+	if errors.As(failure, &shared) {
+		return shared.claimed.CompareAndSwap(false, true)
+	}
+	return true
+}
+
+func (c *Client) RefreshToken(account *auth.Auth) error {
+	return c.RefreshTokenContext(context.Background(), account)
+}
+
+func (c *Client) RefreshTokenContext(ctx context.Context, account *auth.Auth) error {
+	if account == nil {
+		return fmt.Errorf("missing refresh account")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	account.Lock()
+	accessBefore, refreshBefore := account.AccessToken, account.RefreshToken
+	account.Unlock()
+	c.refreshMu.Lock()
+	if c.refreshCalls == nil {
+		c.refreshCalls = make(map[*auth.Auth]*refreshCall)
+	}
+	call := c.refreshCalls[account]
+	if call == nil {
+		account.Lock()
+		changed := account.AccessToken != accessBefore || account.RefreshToken != refreshBefore
+		account.Unlock()
+		if changed {
+			c.refreshMu.Unlock()
+			return nil
+		}
+		call = &refreshCall{done: make(chan struct{})}
+		c.refreshCalls[account] = call
+		go func() {
+			refreshContext, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+			defer cancel()
+			failure := account.RefreshSerialized(refreshContext, func() error { return c.refreshToken(account) })
+			if failure != nil {
+				failure = &refreshFailure{cause: failure}
+			}
+			c.refreshMu.Lock()
+			call.err = failure
+			delete(c.refreshCalls, account)
+			close(call.done)
+			c.refreshMu.Unlock()
+		}()
+	}
+	c.refreshMu.Unlock()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-call.done:
+		return call.err
+	}
+}

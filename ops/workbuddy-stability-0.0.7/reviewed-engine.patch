+		t.Fatal("small request lost stickiness")
+	}
+	if accounts.RoutingExclusions(map[string]bool{"spare": true}, "", "", 100)["busy"] {
+		t.Fatal("budget blocked all available accounts")
+	}
+	for index := 0; index < 5000; index++ {

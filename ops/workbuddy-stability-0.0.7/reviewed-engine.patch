+	}
+	accounts.mu.Lock()
+	if len(accounts.byUID["busy"].largeRequests) != 2 {
+		t.Fatal("unbounded sliding history")
+	}
+	accounts.byUID["busy"].largeRequests = []time.Time{time.Now().Add(-2 * time.Minute)}
+	accounts.mu.Unlock()
+	if accounts.RoutingExclusions(nil, "", "", 100)["busy"] {
+		t.Fatal("expired budget did not recover")
+	}
+}

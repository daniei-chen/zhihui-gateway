+func TestSmallBudgetUsesRealPayloadPipeline(t *testing.T) {
+	output := PrepareBodyOpt([]byte(`{"model":"deepseek-v4.1-flash","max_completion_tokens":64,"messages":[{"role":"user","content":"synthetic"}]}`), false)
+	var body map[string]any
+	if err := json.Unmarshal(output, &body); err != nil {

+func TestRefreshSingleflightForSameAccount(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(map[bool]string{false: "success", true: "shared-error"}[fail], func(t *testing.T) {
+			var calls atomic.Int32
+			entered := make(chan struct{}, 32)
+			release := make(chan struct{})
+			client := testClient(rtFunc(func(request *http.Request) (*http.Response, error) {
+				calls.Add(1)
+				entered <- struct{}{}
+				<-release
+				if fail {
+					return nil, errors.New("synthetic refresh failure")
+				}
+				return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(
+					`{"code":0,"data":{"accessToken":"synthetic-new-access","refreshToken":"synthetic-new-refresh","expiresIn":3600}}`)), Header: http.Header{}}, nil
+			}))
+			account := &auth.Auth{UID: "synthetic-account", AccessToken: "synthetic-old-access", RefreshToken: "synthetic-old-refresh"}
+			var waiters sync.WaitGroup
+			failures := make(chan error, 32)
+			start := make(chan struct{})
+			for index := 0; index < 32; index++ {
+				waiters.Add(1)
+				go func() {
+					defer waiters.Done()
+					<-start
+					failures <- client.RefreshToken(account)
+				}()
+			}
+			close(start)
+			<-entered
+			time.Sleep(100 * time.Millisecond)
+			close(release)
+			waiters.Wait()
+			close(failures)
+			if got := calls.Load(); got != 1 {
+				t.Fatalf("refresh sends=%d want=1", got)
+			}
+			penalties := 0
+			for failure := range failures {
+				if (failure != nil) != fail {
+					t.Fatalf("shared result=%v fail=%v", failure, fail)
+				}
+				if ClaimRefreshPenalty(failure) {
+					penalties++
+				}
+			}
+			if fail && penalties != 1 {
+				t.Fatalf("shared failure penalties=%d want=1", penalties)
+			}
+		})
+	}
+}

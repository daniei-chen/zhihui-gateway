+package auth
+
+import (
+	"errors"
+	"os"
+	"syscall"
+	"unsafe"
+)
+
+var credentialKernel = syscall.NewLazyDLL("kernel32.dll")
+var credentialLock = credentialKernel.NewProc("LockFileEx")
+var credentialUnlock = credentialKernel.NewProc("UnlockFileEx")
+
+func openCredentialLock(path, source string) (*os.File, error) {
+	if info, err := os.Lstat(path); err == nil && !info.Mode().IsRegular() {
+		return nil, errors.New("unsafe credential lock")
+	}
+	return os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600)
+}
+
+func tryCredentialLock(handle *os.File) (bool, error) {
+	var overlapped syscall.Overlapped
+	result, _, failure := credentialLock.Call(handle.Fd(), 3, 0, 1, 0, uintptr(unsafe.Pointer(&overlapped)))
+	if result != 0 {
+		return true, nil
+	}
+	if errors.Is(failure, syscall.Errno(33)) {
+		return false, nil
+	}
+	return false, failure
+}
+
+func unlockCredentialLock(handle *os.File) {
+	var overlapped syscall.Overlapped
+	credentialUnlock.Call(handle.Fd(), 0, 1, 0, uintptr(unsafe.Pointer(&overlapped)))
+}
+
+func syncCredentialDirectory(path string) error { return nil }
+
+func prepareCredentialTemp(handle *os.File, source string, existed bool) error { return nil }

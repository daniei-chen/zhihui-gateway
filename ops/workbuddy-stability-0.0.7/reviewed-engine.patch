+package pool
+
+import "time"
+
+func (p *Pool) SetRoutingPreferences(creditFloor int64, largeLimit, threshold int, window time.Duration) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if creditFloor < 0 {
+		creditFloor = 0
+	}
+	if creditFloor > 1000000000 {
+		creditFloor = 1000000000
+	}
+	if largeLimit < 0 {
+		largeLimit = 0
+	}
+	if largeLimit > 1000 {
+		largeLimit = 1000
+	}
+	if threshold <= 0 {
+		threshold = 64 * 1024
+	}
+	if threshold > 128*1024*1024 {
+		threshold = 128 * 1024 * 1024
+	}
+	if window <= 0 {
+		window = 5 * time.Minute
+	}
+	if window > 24*time.Hour {
+		window = 24 * time.Hour
+	}
+	p.creditFloor, p.largeRequestLimit = creditFloor, largeLimit
+	p.largeRequestThreshold, p.largeRequestWindow = threshold, window
+}
+
+func (p *Pool) RoutingExclusions(tried map[string]bool, model, realm string, requestBytes int) map[string]bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.creditFloor == 0 && p.largeRequestLimit == 0 {
+		return tried
+	}
+	now := time.Now()
+	avoid := make(map[string]bool)
+	preferred := 0
+	for uid, candidate := range p.byUID {
+		if tried[uid] || !candidate.healthyForModel(now, model) || p.inFlightFull(candidate) ||
+			(realm != "" && candidate.a.Realm() != realm) || (p.skipExhausted && candidate.exhausted()) {
+			continue
+		}
+		candidate.largeRequests = recentLargeRequests(candidate.largeRequests, now.Add(-p.largeRequestWindow))
+		lowCredit := p.creditFloor > 0 && candidate.creditsKnown && candidate.credits < p.creditFloor
+		largeLimited := p.largeRequestLimit > 0 && requestBytes >= p.largeRequestThreshold && len(candidate.largeRequests) >= p.largeRequestLimit
+		if lowCredit || largeLimited {
+			avoid[uid] = true
+		} else {
+			preferred++
+		}
+	}
+	if preferred == 0 || len(avoid) == 0 {
+		return tried
+	}
+	for uid, excluded := range tried {
+		if excluded {
+			avoid[uid] = true
+		}
+	}
+	return avoid
+}
+
+func (p *Pool) NoteLargeRequest(uid string, requestBytes int) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	candidate := p.byUID[uid]
+	if candidate == nil || p.largeRequestLimit == 0 || requestBytes < p.largeRequestThreshold {
+		return
+	}
+	now := time.Now()
+	candidate.largeRequests = recentLargeRequests(candidate.largeRequests, now.Add(-p.largeRequestWindow))
+	if len(candidate.largeRequests) >= p.largeRequestLimit {
+		copy(candidate.largeRequests, candidate.largeRequests[1:])
+		candidate.largeRequests = candidate.largeRequests[:len(candidate.largeRequests)-1]
+	}
+	candidate.largeRequests = append(candidate.largeRequests, now)
+}
+
+func recentLargeRequests(events []time.Time, cutoff time.Time) []time.Time {
+	first := 0
+	for first < len(events) && !events[first].After(cutoff) {
+		first++
+	}
+	if first == 0 {
+		return events
+	}
+	copy(events, events[first:])
+	return events[:len(events)-first]
+}

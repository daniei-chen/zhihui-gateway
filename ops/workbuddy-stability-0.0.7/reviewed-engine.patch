+
+func TestCredentialSavePreservesMetadataAndRejectsStaleGeneration(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "workbuddy-synthetic.json")
+	original := []byte(`{"auth":{"accessToken":"synthetic-old","refreshToken":"synthetic-refresh","custom":"preserve"},"account":{"uid":"synthetic","extra":true},"proxy":"synthetic-route","weight":3,"unknown":{"large":9007199254740993}}`)
+	if err := os.WriteFile(path, original, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	current, err := Parse(original)
+	if err != nil {
+		t.Fatal(err)
+	}
+	current.FilePath = path
+	current.AccessToken = "synthetic-new"
+	if err := current.SaveAtomic(); err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var document map[string]json.RawMessage
+	if err = json.Unmarshal(encoded, &document); err != nil {
+		t.Fatal(err)
+	}
+	var unknown struct {
+		Large json.Number `json:"large"`
+	}
+	if err = json.Unmarshal(document["unknown"], &unknown); err != nil || unknown.Large.String() != "9007199254740993" {
+		t.Fatal("unknown metadata was lost or rounded")
+	}
+	stale, err := Parse(original)
+	if err != nil {
+		t.Fatal(err)
+	}
+	stale.FilePath = path
+	stale.AccessToken = "synthetic-stale"
+	if err = stale.SaveAtomic(); err == nil {
+		t.Fatal("stale credential overwrite accepted")
+	}
+	if err = os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	if err = current.SaveAtomic(); err == nil {
+		t.Fatal("deleted source recreated")
+	}
+}
+
+func TestCredentialFileLeaseCoalescesReloadedAuthObjects(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "workbuddy-synthetic.json")
+	raw := []byte(`{"auth":{"accessToken":"synthetic-old","refreshToken":"synthetic-old"},"account":{"uid":"synthetic"}}`)
+	if err := os.WriteFile(path, raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	accounts := make([]*Auth, 32)
+	for index := range accounts {
+		account, err := Parse(raw)
+		if err != nil {
+			t.Fatal(err)
+		}
+		account.FilePath = path
+		accounts[index] = account
+	}
+	var sends atomic.Int32
+	var waiters sync.WaitGroup
+	for _, account := range accounts {
+		waiters.Add(1)
+		go func(current *Auth) {
+			defer waiters.Done()
+			err := current.RefreshSerialized(context.Background(), func() error {
+				sends.Add(1)
+				current.Lock()
+				current.AccessToken, current.RefreshToken = "synthetic-new", "synthetic-new"
+				current.Unlock()
+				return nil
+			})
+			if err != nil {
+				t.Error(err)
+			}
+		}(account)
+	}
+	waiters.Wait()
+	if sends.Load() != 1 {
+		t.Fatalf("file-level refresh sends=%d want=1", sends.Load())
+	}
+	for _, account := range accounts {
+		if account.AccessTokenValue() != "synthetic-new" {
+			t.Fatal("new generation not adopted")
+		}
+	}
+}
+
+func TestCredentialLeaseChild(t *testing.T) {

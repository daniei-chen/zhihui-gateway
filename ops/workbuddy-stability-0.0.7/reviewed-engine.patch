+package auth
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+func lockCredentials(ctx context.Context, path string) (func(), error) {
+	if path == "" {
+		return nil, fmt.Errorf("no credential path")
+	}
+	if info, err := os.Lstat(path); err == nil && !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("credential source must be regular")
+	}
+	handle, err := openCredentialLock(path+".refresh.lock", path)
+	if err != nil {
+		return nil, fmt.Errorf("credential lock unavailable: %w", err)
+	}
+	for {
+		if err := ctx.Err(); err != nil {
+			handle.Close()
+			return nil, err
+		}
+		locked, failure := tryCredentialLock(handle)
+		if failure != nil {
+			handle.Close()
+			return nil, failure
+		}
+		if locked {
+			return func() { unlockCredentialLock(handle); handle.Close() }, nil
+		}
+		select {
+		case <-ctx.Done():
+			handle.Close()
+			return nil, ctx.Err()
+		case <-time.After(25 * time.Millisecond):
+		}
+	}
+}
+
+func (a *Auth) RefreshSerialized(ctx context.Context, refresh func() error) error {
+	a.mu.Lock()
+	path, beforeAccess, beforeRefresh := a.FilePath, a.AccessToken, a.RefreshToken
+	a.mu.Unlock()
+	if path == "" {
+		return refresh()
+	}
+	release, err := lockCredentials(ctx, path)
+	if err != nil {
+		return err
+	}
+	defer release()
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("credential source unavailable: %w", err)
+	}
+	stored, err := Parse(raw)
+	if err != nil {
+		return err
+	}
+	a.mu.Lock()
+	if a.UID != "" && stored.UID != a.UID {
+		a.mu.Unlock()
+		return fmt.Errorf("credential identity changed")
+	}
+	a.sourceKnown, a.sourceExists = true, true
+	a.sourceAccessToken, a.sourceRefreshToken = stored.AccessToken, stored.RefreshToken
+	changed := stored.AccessToken != beforeAccess || stored.RefreshToken != beforeRefresh
+	if changed {
+		a.AccessToken, a.RefreshToken, a.ExpiresAt, a.Domain = stored.AccessToken, stored.RefreshToken, stored.ExpiresAt, stored.Domain
+	}
+	a.mu.Unlock()
+	if changed {
+		if updated, _ := a.BackfillRealm(); updated {
+			return a.saveCredentialHeld()
+		}
+		return nil
+	}
+	if err := refresh(); err != nil {
+		return err
+	}
+	a.BackfillRealm()
+	return a.saveCredentialHeld()
+}
+
+func (a *Auth) saveWithLease() error {
+	a.mu.Lock()
+	path := a.FilePath
+	a.mu.Unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	release, err := lockCredentials(ctx, path)
+	if err != nil {
+		return err
+	}
+	defer release()
+	return a.saveCredentialHeld()
+}
+
+func (a *Auth) saveCredentialHeld() error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if strings.TrimSpace(a.AccessToken) == "" {
+		return fmt.Errorf("save refused: empty accessToken")
+	}
+	document := map[string]any{}
+	raw, readError := os.ReadFile(a.FilePath)
+	existed := readError == nil
+	if readError != nil && (!os.IsNotExist(readError) || a.sourceExists) {
+		return fmt.Errorf("credential source unavailable: %w", readError)
+	}
+	if existed {
+		stored, err := Parse(raw)
+		if err != nil {
+			return err
+		}
+		if (a.UID != "" && stored.UID != a.UID) ||
+			(a.sourceKnown && (stored.AccessToken != a.sourceAccessToken || stored.RefreshToken != a.sourceRefreshToken) &&
+				(stored.AccessToken != a.AccessToken || stored.RefreshToken != a.RefreshToken)) {
+			return fmt.Errorf("credential generation changed; stale save refused")
+		}
+		decoder := json.NewDecoder(bytes.NewReader(raw))
+		decoder.UseNumber()
+		if err := decoder.Decode(&document); err != nil {
+			return err
+		}
+	}
+	credentials, _ := document["auth"].(map[string]any)
+	if credentials == nil {
+		credentials = map[string]any{}
+		document["auth"] = credentials
+	}
+	for name, value := range map[string]any{"accessToken": a.AccessToken, "refreshToken": a.RefreshToken,
+		"expiresAt": a.ExpiresAt, "domain": a.Domain, "realm": a.realm} {
+		credentials[name] = value
+		if _, flat := document[name]; flat {
+			document[name] = value
+		}
+	}
+	account, _ := document["account"].(map[string]any)
+	if account == nil {
+		account = map[string]any{}
+		document["account"] = account
+	}
+	account["uid"] = a.UID
+	if !existed {
+		account["enterpriseId"], account["nickname"] = a.EnterpriseID, a.Nickname
+		if a.DeviceToken != "" {
+			document["device_token"] = a.DeviceToken
+		}
+		if a.ProxyName != "" {
+			document["proxy"] = a.ProxyName
+		}
+		if a.Weight != 0 {
+			document["weight"] = a.Weight
+		}
+	}
+	encoded, err := json.MarshalIndent(document, "", "  ")
+	if err != nil {
+		return err
+	}
+	temporary, err := os.CreateTemp(filepath.Dir(a.FilePath), ".credential-*.tmp")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(temporary.Name())
+	if err = prepareCredentialTemp(temporary, a.FilePath, existed); err != nil {
+		temporary.Close()
+		return err
+	}
+	if _, err = temporary.Write(encoded); err == nil {
+		err = temporary.Sync()
+	}
+	closeError := temporary.Close()
+	if err != nil {
+		return err
+	}
+	if closeError != nil {
+		return closeError
+	}
+	if err = os.Rename(temporary.Name(), a.FilePath); err != nil {
+		return err
+	}
+	if err = syncCredentialDirectory(filepath.Dir(a.FilePath)); err != nil {
+		return err
+	}
+	a.sourceKnown, a.sourceExists = true, true
+	a.sourceAccessToken, a.sourceRefreshToken = a.AccessToken, a.RefreshToken
+	return nil
+}

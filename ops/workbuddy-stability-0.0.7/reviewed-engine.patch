+		{"completion-alias", `{"model":"deepseek-v4.1-flash","max_completion_tokens":256}`, ""},
+		{"large", `{"model":"deepseek-v4.1-flash","max_tokens":1025}`, "enabled"},
+		{"missing", `{"model":"deepseek-v4.1-flash"}`, "enabled"},
+		{"invalid-zero", `{"model":"deepseek-v4.1-flash","max_tokens":0}`, "enabled"},
+		{"invalid-fraction", `{"model":"deepseek-v4.1-flash","max_tokens":0.5}`, "enabled"},

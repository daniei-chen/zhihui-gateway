+type auditUpstreamReadFailure struct{}
+
+func (auditUpstreamReadFailure) Read(p []byte) (int, error) { return 0, io.ErrUnexpectedEOF }
+
+type auditCancelledRead struct{ cancel context.CancelFunc }
+
+func (r auditCancelledRead) Read(p []byte) (int, error) { r.cancel(); return 0, context.Canceled }
+
+func TestAuditFixDownstreamCancellationDuringReadIs499Not502(t *testing.T) {
+	withChatLog(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	calls := 0
+	wire := `data: {"choices":[{"delta":{"content":"partial"}}]}` + "\n\n"
+	client := &upstream.Client{HTTP: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"text/event-stream"}}, Body: io.NopCloser(io.MultiReader(strings.NewReader(wire), auditCancelledRead{cancel})), Request: r}, nil
+	})}, ChatBaseCN: "https://synthetic.invalid"}
+	p := testPoolWith(&auth.Auth{UID: "one", AccessToken: "synthetic", ExpiresAt: 9999999999})
+	h := NewHandler(Config{Pool: p, Upstream: client, MaxRotate: 3})
+	request := httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(`{"model":"m","stream":true,"messages":[{"role":"user","content":"hi"}]}`)).WithContext(ctx)
+	logged := captureStdout(t, func() { h.ServeHTTP(httptest.NewRecorder(), request) })
+	status, _ := p.Status("one")
+	if calls != 1 || status.SuccessCount != 0 || !strings.Contains(logged, "| 499 |") || strings.Contains(logged, "| 502 |") {
+		t.Fatalf("cancel misclassified or replayed: calls=%d success=%d log=%s", calls, status.SuccessCount, logged)
+	}
+}

+func TestAuditFixHandlerDoesNotReplayAggregateFailure(t *testing.T) {
+	for _, body := range []string{
+		`data: {"error":{"code":11128,"message":"Illegal API invocation from an unapproved channel"}}` + "\n\ndata: [DONE]\n\n",
+		`data: {"choices":[{"delta":{"content":"partial"}}]}` + "\n\n",
+	} {
+		calls := 0
+		client := &upstream.Client{HTTP: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+			calls++
+			return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"text/event-stream"}}, Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+		})}, ChatBaseCN: "https://synthetic.invalid"}
+		p := testPoolWith(&auth.Auth{UID: "one", AccessToken: "synthetic", ExpiresAt: 9999999999})
+		h := NewHandler(Config{Pool: p, Upstream: client, MaxRotate: 3})
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(`{"model":"m","messages":[{"role":"user","content":"hi"}]}`)))
+		if w.Code < 400 || calls != 1 || strings.Contains(w.Body.String(), `"object":"chat.completion"`) {
+			t.Fatalf("failure fabricated or replayed: code=%d calls=%d body=%s", w.Code, calls, w.Body.String())
+		}
+		if strings.Contains(body, "11128") && w.Code != 400 {
+			t.Fatalf("supplier 11128 status lost: %d", w.Code)
+		}
+		status, _ := p.Status("one")
+		if status.SuccessCount != 0 {
+			t.Fatal("failed upstream response counted as account success")
+		}
+	}
+}

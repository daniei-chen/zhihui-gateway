+package pool
+
+import (
+	"testing"
+	"workbuddy2api/internal/auth"
+)
+
+func TestAuditFixLeaseSurvivesRemovalAndReadd(t *testing.T) {
+	p := New("")
+	p.SetMaxInFlight(2)
+	account := &auth.Auth{UID: "synthetic", AccessToken: "synthetic"}
+	p.Add(account)
+	old := p.AcquireLease(account.UID)
+	if old == nil {
+		t.Fatal("first lease missing")
+	}
+	p.SyncToDir(nil)
+	p.SyncToDir([]*auth.Auth{account})
+	current := p.AcquireLease(account.UID)
+	if current == nil || p.AcquireLease(account.UID) != nil {
+		t.Fatal("same physical account bypassed the limit")
+	}
+	old.Release()
+	old.Release()
+	extra := p.AcquireLease(account.UID)
+	if extra == nil || p.AcquireLease(account.UID) != nil {
+		t.Fatal("old duplicate release affected another lease")
+	}
+	current.Release()
+	extra.Release()
+	p.SyncToDir(nil)
+	if len(p.retired) != 0 {
+		t.Fatal("completed tombstones were retained")
+	}
+}
+
+func TestAuditFixUnlimitedLeaseStillCountsAfterLimitAndReimport(t *testing.T) {
+	p := New("")
+	p.SetMaxInFlight(0)
+	account := &auth.Auth{UID: "synthetic", AccessToken: "synthetic"}
+	p.Add(account)
+	old := p.AcquireLease(account.UID)
+	if old == nil {
+		t.Fatal("unlimited lease missing")
+	}
+	p.SyncToDir(nil)
+	p.SetMaxInFlight(1)
+	p.SyncToDir([]*auth.Auth{account})
+	if lease := p.AcquireLease(account.UID); lease != nil {
+		lease.Release()
+		t.Fatal("unlimited old lease bypassed new limit")
+	}
+	old.Release()
+	current := p.AcquireLease(account.UID)
+	if current == nil {
+		t.Fatal("released old lease did not free its entry")
+	}
+	old.Release()
+	if lease := p.AcquireLease(account.UID); lease != nil {
+		lease.Release()
+		t.Fatal("duplicate old release freed current lease")
+	}
+	current.Release()
+}

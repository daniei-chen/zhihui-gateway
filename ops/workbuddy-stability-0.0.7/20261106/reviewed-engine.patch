+func TestAuditFixActualHandlerNamespacesTenantHeaders(t *testing.T) {
+	var captured [][4]string
+	client := &upstream.Client{HTTP: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		captured = append(captured, [4]string{r.Header.Get("X-Conversation-ID"), r.Header.Get("X-Conversation-Request-ID"), r.Header.Get("X-Trace-ID"), r.Header.Get("X-B3-TraceId")})
+		return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"text/event-stream"}}, Body: io.NopCloser(strings.NewReader(sseOK)), Request: r}, nil
+	})}, ChatBaseCN: "https://synthetic.invalid"}
+	p := testPoolWith(&auth.Auth{UID: "one", AccessToken: "synthetic", ExpiresAt: 9999999999})
+	sticky := session.New(session.Config{Available: func() []string { return []string{"one"} }})
+	h := NewHandler(Config{Pool: p, Upstream: client, Session: sticky, APIKey: "synthetic-link"})
+	for _, tenant := range []string{"key:A/upstream:1", "key:B/upstream:1", "key:A/upstream:1"} {
+		r := httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(`{"model":"m","conversation_id":"same-client-id","messages":[{"role":"user","content":"same"}]}`))
+		r.Header.Set("Authorization", "Bearer synthetic-link")
+		r.Header.Set("X-WB-Tenant", tenant)
+		r.Header.Set("X-Conversation-Request-ID", "same-client-turn")
+		r.Header.Set("X-Trace-ID", "same-client-trace")
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		if w.Code != 200 {
+			t.Fatalf("request failed: %d %s", w.Code, w.Body.String())
+		}
+	}
+	if len(captured) != 3 || captured[0] != captured[2] || captured[0][0] == captured[1][0] || captured[0][1] == captured[1][1] {
+		t.Fatalf("tenant aggregation isolation lost: %#v", captured)
+	}
+	for _, ids := range captured {
+		if len(ids[1]) != 32 {
+			t.Fatalf("invalid supplier request-ID shape: %q", ids[1])
+		}
+	}
+	for i := 0; i < 4; i++ {
+		if captured[0][i] == captured[1][i] {
+			t.Fatalf("tenant header %d was shared", i)
+		}
+	}
+}

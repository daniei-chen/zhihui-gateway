+func TestAuditFixOversizedTenantDoesNotFallBackToBareKey(t *testing.T) {
+	request := httptest.NewRequest("POST", "/v1/chat/completions", nil)
+	request.Header.Set("X-WB-Tenant", strings.Repeat("a", 1024))
+	first := tenantSessionKey(request, "synthetic", "cn", "client-key")
+	request.Header.Set("X-WB-Tenant", strings.Repeat("b", 1024))
+	second := tenantSessionKey(request, "synthetic", "cn", "client-key")
+	if first == "client-key" || first == second {
+		t.Fatal("oversized tenant lost its namespace")
+	}
+}

+func TestAuditFixSupplierFailureIsObservedAs502Not499(t *testing.T) {
+	withChatLog(t)
+	resetMetricsForTest(t)
+	client := &upstream.Client{HTTP: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"text/event-stream"}},
+			Body: io.NopCloser(strings.NewReader(`data: {"error":{"code":11128,"message":"synthetic refusal"}}` + "\n\ndata: [DONE]\n\n")), Request: r}, nil
+	})}, ChatBaseCN: "https://synthetic.invalid"}
+	p := testPoolWith(&auth.Auth{UID: "one", AccessToken: "synthetic", ExpiresAt: 9999999999})
+	h := NewHandler(Config{Pool: p, Upstream: client})
+	rec := httptest.NewRecorder()
+	logged := captureStdout(t, func() {
+		h.ServeHTTP(rec, httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(`{"model":"m","stream":true,"messages":[{"role":"user","content":"hi"}]}`)))
+	})
+	status, _ := p.Status("one")
+	if status.SuccessCount != 0 || !strings.Contains(logged, "| 502 |") || strings.Contains(logged, "| 499 |") {
+		t.Fatalf("supplier error misclassified: success=%d log=%s", status.SuccessCount, logged)
+	}
+}

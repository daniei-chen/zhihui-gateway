+func TestRemainingAuditRefreshNetworkInheritsOwnedDeadline(t *testing.T) {
+	received := make(chan struct{})
+	release := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		close(received)
+		select {
+		case <-r.Context().Done():
+		case <-release:
+		}
+	}))
+	defer server.Close()
+	defer close(release)
+	client := New()
+	client.ChatBaseCN = server.URL
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	started := time.Now()
+	err := client.refreshTokenWithContext(ctx, &auth.Auth{UID: "synthetic", AccessToken: "fixture", RefreshToken: "fixture-refresh"})
+	if err == nil || time.Since(started) > 2*time.Second {
+		t.Fatalf("refresh ignored owned deadline: %v", err)
+	}
+	select {
+	case <-received:
+	default:
+		t.Fatal("fixture did not reach the local HTTP server")
+	}
+	if !errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		t.Fatal("parent deadline was not the cancellation authority")
+	}
+}
+
+func TestRemainingAuditReasoningAndPostFinishTailShareAccumulatedCap(t *testing.T) {
+	t.Setenv("WB2A_MAX_OUTPUT_BYTES", "65536")
+	for _, field := range []string{"reasoning_content", "content"} {
+		frame := `data: {"choices":[{"delta":{"` + field + `":"` + strings.Repeat("x", 1024) + `"}}]}` + "\n\n"
+		input := strings.Repeat(frame, 100) + "data: [DONE]\n\n"
+		if result, failure := Aggregate(strings.NewReader(input)); failure == nil || result != nil {
+			t.Fatal("aggregate retained an excessive reasoning/content history")
+		}
+		writer := httptest.NewRecorder()
+		if failure := StreamHint(writer, strings.NewReader(input), nil); failure == nil {
+			t.Fatal("stream accepted accumulated output over the cap")
+		}
+	}
+	finish := `data: {"choices":[{"delta":{"content":"ok"},"finish_reason":"stop"}]}` + "\n\n"
+	tail := `data: {"usage":{"unrecognized":"` + strings.Repeat("x", 1024) + `"}}` + "\n\n"
+	writer := httptest.NewRecorder()
+	if failure := StreamHint(writer, strings.NewReader(finish+strings.Repeat(tail, 100)), nil); failure == nil {

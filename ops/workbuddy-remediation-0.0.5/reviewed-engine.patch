@@ -0,0 +1,15 @@
+package upstream
+
+import (
+	"errors"
+	"net"
+)
+
+func DefinitelyUnsent(failure error) bool {
+	var network *net.OpError
+	if errors.As(failure, &network) && network.Op == "dial" {
+		return true
+	}
+	var resolution *net.DNSError
+	return errors.As(failure, &resolution)
+}

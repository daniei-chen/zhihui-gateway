+package server
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"workbuddy2api/internal/auth"
+	"workbuddy2api/internal/upstream"
+)
+
+func TestRemediationToolNumericArgumentsStayValid(test *testing.T) {
+	raw := []byte(`{"model":"m","messages":[{"role":"user","content":" 11128 "},{"role":"assistant","tool_calls":[{"id":"call","type":"function","function":{"name":"connect","arguments":"{\"port\":11128}"}}]},{"role":"tool","tool_call_id":"call","content":"11128"}]}`)
+	prepared := upstream.PrepareBodyOpt(raw, true)
+	var value map[string]any
+	if failure := json.Unmarshal(prepared, &value); failure != nil {
+		test.Fatal(failure)
+	}
+	messages := value["messages"].([]any)
+	call := messages[1].(map[string]any)["tool_calls"].([]any)[0].(map[string]any)
+	arguments := call["function"].(map[string]any)["arguments"].(string)
+	if arguments != `{"port":11128}` || !json.Valid([]byte(arguments)) || messages[0].(map[string]any)["content"] != " 11128 " {
+		test.Fatalf("business history changed: %s", prepared)
+	}
+}
+
+func TestRemediationAcceptedDisconnectIsNotReplayed(test *testing.T) {
+	accepted := 0
+	client := &upstream.Client{HTTP: &http.Client{Transport: roundTripFunc(func(request *http.Request) (*http.Response, error) {
+		io.Copy(io.Discard, request.Body)
+		accepted++
+		return nil, io.ErrUnexpectedEOF
+	})}, ChatBaseCN: "https://fake.example"}
+	accounts := testPoolWith(&auth.Auth{UID: "first", AccessToken: "synthetic", ExpiresAt: 9999999999},
+		&auth.Auth{UID: "second", AccessToken: "synthetic", ExpiresAt: 9999999999})
+	handler := NewHandler(Config{Pool: accounts, Upstream: client})
+	recorder := httptest.NewRecorder()
+	handler.ServeHTTP(recorder, httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(`{"model":"m","messages":[{"role":"user","content":"hi"}]}`)))
+	if accepted != 1 || recorder.Code != 502 || !strings.Contains(recorder.Body.String(), "upstream_transport_uncertain") {
+		test.Fatalf("uncertain request replayed: accepted=%d status=%d", accepted, recorder.Code)
+	}
+}
+
+func TestRemediationRefusalDoesNotChangeAnotherTenant(test *testing.T) {
+	var bodies [][]byte
+	client := newBodyCaptureUpstream(test, &bodies, func(call int, body string) (int, string, bool) {
+		if call == 1 {
+			return 400, `{"code":11128,"msg":"blocked by security policy"}`, false
+		}
+		return 200, sseOK, true
+	})
+	handler := NewHandler(Config{Pool: testPoolWith(&auth.Auth{UID: "one", AccessToken: "synthetic", ExpiresAt: 9999999999}), Upstream: client})
+	for _, policy := range []string{"tenant-A", "tenant-B"} {
+		handler.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(`{"model":"m","stream":true,"messages":[{"role":"system","content":"`+policy+`"},{"role":"user","content":"hi"}]}`)))
+	}
+	if len(bodies) != 2 || !strings.Contains(string(bodies[1]), "tenant-B") || handler.degrade.Active() {
+		test.Fatal("shared prompt degradation remains")
+	}
+}
+
+func TestRemediationProviderEventsHaveIndependentDispatches(test *testing.T) {
+	root := test.TempDir()
+	test.Setenv("WB2A_AUDIT_DIR", root)
+	for _, dispatch := range []string{"dispatch-one", "dispatch-two"} {
+		request := httptest.NewRequest("POST", "/v1/chat/completions", nil)
+		request.Header.Set("X-Manager-Request-ID", "same-execution")
+		observer := providerObserver(request, dispatch, 1, "account", "model", "cn")
+		if failure := observer(1, "sending", 0, "/v2/chat/completions"); failure != nil {
+			test.Fatal(failure)
+		}
+	}
+	files, failure := os.ReadDir(root)
+	if failure != nil || len(files) != 2 {
+		test.Fatalf("independent evidence missing: %v", failure)
+	}
+	for _, file := range files {
+		raw, failure := os.ReadFile(filepath.Join(root, file.Name()))
+		if failure != nil || !json.Valid(raw) {
+			test.Fatal("invalid durable evidence")
+		}

--- a/internal/server/provider_audit.go
+++ b/internal/server/provider_audit.go
@@ -0,0 +1,88 @@
+package server
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"runtime"
+	"time"
+)
+
+var auditIdentity = regexp.MustCompile(`^[A-Za-z0-9_.:-]{1,128}$`)
+
+func newAuditID() string {
+	var random [16]byte
+	if _, failure := rand.Read(random[:]); failure != nil {
+		panic(failure)
+	}
+	return hex.EncodeToString(random[:])
+}
+
+func providerObserver(request *http.Request, dispatch string, rotation int, account, model, realm string) func(int, string, int, string) error {
+	execution := request.Header.Get("X-Manager-Request-ID")
+	if execution == "" {
+		execution = request.Header.Get("X-Request-ID")
+	}
+	if !auditIdentity.MatchString(execution) {
+		execution = dispatch
+	}
+	return func(provider int, phase string, status int, path string) error {
+		root := os.Getenv("WB2A_AUDIT_DIR")
+		if root == "" {
+			root = "./data/provider-events-v2"
+		}
+		if failure := os.MkdirAll(root, 0o700); failure != nil {
+			return failure
+		}
+		metadata, failure := os.Lstat(root)
+		if failure != nil || !metadata.IsDir() || metadata.Mode()&os.ModeSymlink != 0 || runtime.GOOS != "windows" && metadata.Mode().Perm()&0o022 != 0 {
+			return fmt.Errorf("unsafe provider evidence directory")
+		}
+		event := map[string]any{"event": "workbuddy_provider_attempt_v2", "request_id": execution,
+			"dispatch_id": dispatch, "rotation": rotation, "provider_attempt": provider,
+			"phase": phase, "status": status, "account_uid": account, "model": model,
+			"realm": realm, "path": path, "ts": time.Now().Unix()}
+		raw, failure := json.Marshal(event)
+		if failure != nil {
+			return failure
+		}
+		name := fmt.Sprintf("%s-%02d-%02d-%s.json", dispatch, rotation, provider, phase)
+		target := filepath.Join(root, name)
+		file, failure := os.CreateTemp(root, ".provider-*.tmp")
+		if failure != nil {
+			return failure
+		}
+		temporary := file.Name()
+		defer os.Remove(temporary)
+		if _, failure = file.Write(raw); failure == nil {
+			failure = file.Sync()
+		}
+		closed := file.Close()
+		if failure != nil {
+			return failure
+		}
+		if closed != nil {
+			return closed
+		}
+		if failure = os.Link(temporary, target); failure != nil {
+			return failure
+		}
+		if failure = os.Remove(temporary); failure != nil {
+			return failure
+		}
+		if runtime.GOOS == "windows" {
+			return nil
+		}
+		directory, failure := os.Open(root)
+		if failure != nil {
+			return failure
+		}
+		defer directory.Close()
+		return directory.Sync()
+	}
+}

[Unit]
Description=ZHIHUI Gateway candidate Manager (shared admission, no background jobs)
After=network.target docker.service
# The helper is the handoff generation.  It must survive the predecessor's
# stop; a dependency on the predecessor would tear it down at the
# exact point where it is protecting the public relay.
ConditionPathExists=!/opt/zhihui-release/writer-state/workbuddy-web.service.start-blocked

[Service]
Type=simple
WorkingDirectory=/opt/workbuddy-manager
User=root
Group=root
Environment=WB_MANAGER_HOST=127.0.0.1
Environment=WB_MANAGER_PORT=7865
Environment=WB2API_BASE=http://127.0.0.1:7863
Environment=WB2API_CONTAINER=zhihui-workbuddy
Environment=WB_AUTH_DIR=/opt/workbuddy2api/auths
Environment=WB_UPSTREAM_CONFIG=/opt/workbuddy2api/config.json
Environment=WB_DATA_DIR=/opt/workbuddy-manager/data
Environment=WB_STATIC_DIR=/opt/workbuddy-manager/releases/current/web/out
Environment=WB_SECURE_COOKIE=auto
Environment=WB_TRUST_PROXY=1
Environment=WB_TRUSTED_PROXY_HOPS=1
Environment=WB_ENABLE_DOCS=0
Environment=WB_DRAIN_TIMEOUT_SEC=75
Environment=WB_UPSTREAM_TIMEOUT=300
Environment=WB_GATEWAY_MAX_BODY_CEILING_MB=64
Environment=WB_GATEWAY_MAX_FORWARD_BODY_MB=64
Environment=WB_GATEWAY_MAX_INFLIGHT_BODY_BYTES=402653184
Environment=WB_GATEWAY_MAX_BODY_MB=64
Environment=WB_GATEWAY_MAX_CONCURRENCY=64
Environment=WB_GATEWAY_LARGE_MAX_CONCURRENCY=28
Environment=WB_KEY_CONCURRENCY=30
Environment=WB_KEY_CONCURRENCY_QUOTA=30
Environment=WB_KEY_BUDGET_PENDING=100000
Environment=WB_KEY_BUDGET_PENDING_QUOTA=100000
Environment=WB_GATEWAY_RATE_PER_MIN=600
Environment=WB_SAFE_RETRY_MAX=3
Environment=WB_FIRST_BYTE_TIMEOUT_S=240
Environment=WB_SHARED_ADMISSION=1
Environment=WB_BACKGROUND_JOBS=0
EnvironmentFile=-/opt/workbuddy-manager/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONSAFEPATH=1
Environment=PYTHONPYCACHEPREFIX=/opt/zhihui-release/python-cache
Environment=PYTHONPATH=/opt/workbuddy-manager
ExecStart=/usr/bin/python3 -I -S -B -X pycache_prefix=/opt/zhihui-release/python-cache /opt/zhihui-release/writer-guard/writer_entry.py helper
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
RestrictSUIDSGID=yes
RestrictRealtime=yes
TimeoutStopSec=90
KillMode=control-group
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
